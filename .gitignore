# Exclude editor config
.vscode/
# Exclude temporary folders
build/
build-codex/
# Keep the logs directory skeleton via .gitkeep files, but ignore generated payloads.
logs/**
!logs/**/
!logs/.gitkeep
!logs/**/*.gitkeep
debug_logs/
__pycache__/
*.pyc
# Exclude macOS folder attributes
.DS_Store
# Exclude macOS Info.framework.plist
Info.framework.plist
# MuJoCo
MUJOCO_LOG.TXT
MJDATA.TXT
MJMODEL.TXT
